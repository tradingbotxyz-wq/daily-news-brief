# Copy to .env and fill in. Everything has a safe default for local testing.
PORT=3000
PUBLIC_URL=https://news.example.com      # your live URL (HTTPS is required for install + push)
SECURE_COOKIES=true                      # true when served over HTTPS

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-long-password      # used only the first time the server starts

# Secret Claude uses to post drafts to /api/ingest. Generate: openssl rand -hex 32
INGEST_API_KEY=

# Sections whose heading matches this pattern are Premium by default
PREMIUM_SECTIONS=market|stock
PREMIUM_PRICE_PAISE=9900                 # ₹99
PREMIUM_DAYS=30

# Razorpay (leave blank for demo mode, where "Go Premium" is free)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Push notifications. Keys are auto-generated into data/vapid.json if left blank.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

SEED_SAMPLE=true                         # add two sample briefs on first run
DATA_DIR=./data
